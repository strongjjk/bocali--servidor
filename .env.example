# Bocali v1.0 RC2 - configure estes valores como variaveis secretas na hospedagem.
BOCALI_MODE=production
BOCALI_PUBLIC_ORIGIN=https://SEU-DOMINIO-HTTPS
BOCALI_DATA_DIR=/data
# Gere localmente e cole SOMENTE na hospedagem:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
BOCALI_SECRET_KEY=
# Deixe vazios na versao oficial. Use apenas se quiser fechar uma homologacao.
BOCALI_PILOT_CODE=
BOCALI_SETUP_TOKEN=
BOCALI_DEMO_ADDRESSES=0
BOCALI_ENABLE_PDF=1

# Mercado Pago. Comece em test e mude para production somente depois da homologacao.
BOCALI_MP_ENVIRONMENT=test
# Nunca coloque Access Token, Webhook Secret ou outras chaves no APK/repo/chat.
# Public Key e opcional neste RC (reservada para uma futura integracao nativa).
BOCALI_MP_PUBLIC_KEY=
BOCALI_MP_ACCESS_TOKEN=
BOCALI_MP_WEBHOOK_SECRET=

# Opcional no primeiro teste por retirada. Necessario para validar enderecos reais de entrega.
GEOAPIFY_API_KEY=
